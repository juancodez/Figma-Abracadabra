{
  "name": "voice-to-figma",
  "version": "0.1.0",
  "description": "Windows voice loop for figma-cli. Say 'Hey Figma, create a button' and it appears.",
  "type": "module",
  "bin": {
    "figma-voice": "./voice.mjs"
  },
