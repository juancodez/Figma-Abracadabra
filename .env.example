# Required. Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Path to the installed figma-cli repo (CLAUDE.md + plugins/voice/* live here).
# Default assumes the standard install location.
FIGMA_CLI_PATH=C:\Users\tn\figma-cli

# Default mode: "call" (requires "Hey Figma" wake phrase) or "studio" (Haiku classifier on every utterance).
MODE=call

# Wake phrase for call mode. Case-insensitive, matched at start of utterance.
WAKE=hey figma

# Models (filenames inside .\bin\)
WHISPER_BIN=whisper.exe
WHISPER_MODEL=ggml-small.en-q5_1.bin
VAD_MODEL=silero_vad.onnx

# Claude models
MODEL_EXECUTOR=claude-sonnet-4-6
MODEL_GATE=claude-haiku-4-5-20251001

# Mic device name as shown by `ffmpeg -list_devices true -f dshow -i dummy`.
# Leave blank on first run — the picker will set it for you.
MIC_DEVICE=

# Advanced
VAD_SILENCE_MS=600
VAD_THRESHOLD=0.5
CALL_WINDOW_MS=10000
